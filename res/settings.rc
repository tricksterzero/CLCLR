// 設定画面。app.rc から読み込む（文字コードは app.rc の #pragma code_page(65001) で UTF-8）。
// 親のダイアログにタブを置き、タブごとの中身は子のダイアログ（DS_CONTROL | WS_CHILD）にする。
// 大きさは固定。すべての項目がはみ出さないことをテストで確かめる（native/settings.rs）。
// 見出し（LTEXT）は、それが指す入力欄のすぐ前に置く（アクセスキーが次の入力欄へフォーカスを移すため）。
// 上下のボタン（msctls_updown32 の UDS_AUTOBUDDY）は、数値の入力欄のすぐ後に置く。

IDD_SETTINGS DIALOGEX 0, 0, 300, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "設定"
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    CONTROL "", IDC_SET_TAB, "SysTabControl32", WS_TABSTOP, 7, 7, 286, 250
    LTEXT "", IDC_SET_ERROR, 7, 261, 190, 36
    DEFPUSHBUTTON "OK", IDOK, 200, 266, 45, 15
    PUSHBUTTON "キャンセル", IDCANCEL, 248, 266, 45, 15
END

IDD_PAGE_GENERAL DIALOGEX 0, 0, 280, 232
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    AUTOCHECKBOX "クリップボードを監視する(&W)", IDC_GEN_WATCH, 7, 7, 266, 10, WS_TABSTOP
    AUTOCHECKBOX "トレイアイコンを表示する(&T)", IDC_GEN_TRAY, 7, 22, 266, 10, WS_TABSTOP
    AUTOCHECKBOX "起動時にビューアを表示しない（トレイ常駐で開始）(&H)", IDC_GEN_START_HIDDEN, 7, 37, 266, 10, WS_TABSTOP
    LTEXT "（次の起動から有効）", -1, 19, 49, 254, 8
    AUTOCHECKBOX "起動時にクリップボードを同期する(&S)", IDC_GEN_SYNC, 7, 64, 266, 10, WS_TABSTOP
    LTEXT "（空なら最新の履歴を戻し、データがあれば取り込む）", -1, 19, 76, 254, 8
    AUTOCHECKBOX "ビューアの操作の失敗を知らせる(&N)", IDC_GEN_NOTIFY, 7, 91, 266, 10, WS_TABSTOP
END

IDD_PAGE_HISTORY DIALOGEX 0, 0, 280, 232
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    LTEXT "最大件数（0=無制限）(&M)", -1, 7, 9, 116, 8
    EDITTEXT IDC_HIS_MAX, 126, 7, 50, 12, ES_NUMBER | WS_TABSTOP
    CONTROL "", IDC_HIS_MAX_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0
    AUTOCHECKBOX "古い履歴をフォルダにまとめる（階層表示）(&G)", IDC_HIS_GROUP, 7, 23, 266, 10, WS_TABSTOP
    LTEXT "直下に表示する件数(&V)", -1, 19, 38, 104, 8
    EDITTEXT IDC_HIS_VISIBLE, 126, 36, 50, 12, ES_NUMBER | WS_TABSTOP
    CONTROL "", IDC_HIS_VISIBLE_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0
    LTEXT "フォルダ数(&F)", -1, 19, 53, 104, 8
    EDITTEXT IDC_HIS_FOLDERS, 126, 51, 50, 12, ES_NUMBER | WS_TABSTOP
    CONTROL "", IDC_HIS_FOLDERS_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0
    LTEXT "フォルダ内の件数(&I)", -1, 19, 68, 104, 8
    EDITTEXT IDC_HIS_PER_FOLDER, 126, 66, 50, 12, ES_NUMBER | WS_TABSTOP
    CONTROL "", IDC_HIS_PER_FOLDER_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0
    LTEXT "フォルダ名の書式(&O)", -1, 19, 83, 104, 8
    EDITTEXT IDC_HIS_FORMAT, 126, 81, 80, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "（%1=先頭番号、%2=末尾番号）", -1, 126, 95, 147, 8
    LTEXT "", IDC_HIS_TOTAL, 19, 107, 254, 8
    LTEXT "重複チェック(&D)", -1, 7, 124, 116, 8
    COMBOBOX IDC_HIS_OVERLAP, 126, 122, 100, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "追加までの遅延（ミリ秒）(&Y)", -1, 7, 140, 116, 8
    EDITTEXT IDC_HIS_INTERVAL, 126, 138, 50, 12, ES_NUMBER | WS_TABSTOP
    CONTROL "", IDC_HIS_INTERVAL_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0
    AUTOCHECKBOX "終了時に履歴を保存する(&X)", IDC_HIS_SAVE_EXIT, 7, 155, 130, 10, WS_TABSTOP
    AUTOCHECKBOX "変更の都度履歴を保存する(&C)", IDC_HIS_SAVE_CHANGE, 140, 155, 133, 10, WS_TABSTOP
    LTEXT "（両方オフで完全メモリモード。保存の有無の切り替えは次の起動から有効）", -1, 19, 167, 254, 8
    AUTOCHECKBOX "アイテム送出によるクリップボード変更を履歴に加えない(&E)", IDC_HIS_DELETE_ON_SEND, 7, 182, 266, 10, WS_TABSTOP
    AUTOCHECKBOX "履歴に追加された時に音を鳴らす(&U)", IDC_HIS_SOUND, 7, 197, 266, 10, WS_TABSTOP
    LTEXT "WAVファイル（空欄はシステム音）(&A)", -1, 19, 213, 116, 8
    EDITTEXT IDC_HIS_SOUND_FILE, 138, 211, 135, 12, ES_AUTOHSCROLL | WS_TABSTOP
END

IDD_PAGE_HOTKEY DIALOGEX 0, 0, 280, 232
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    AUTOCHECKBOX "ポップアップメニューのホットキー(&P)", IDC_HK_POPUP, 7, 7, 266, 10, WS_TABSTOP
    AUTOCHECKBOX "Ctrl", IDC_HK_CTRL, 19, 22, 36, 10, WS_TABSTOP
    AUTOCHECKBOX "Shift", IDC_HK_SHIFT, 58, 22, 40, 10, WS_TABSTOP
    AUTOCHECKBOX "Alt", IDC_HK_ALT, 101, 22, 32, 10, WS_TABSTOP
    AUTOCHECKBOX "Win", IDC_HK_WIN, 136, 22, 34, 10, WS_TABSTOP
    LTEXT "＋ キー(&K)", -1, 176, 23, 40, 8
    EDITTEXT IDC_HK_KEY, 218, 21, 20, 12, WS_TABSTOP
    AUTOCHECKBOX "メニュー選択後に自動でペーストする（Shift押下で抑制）(&A)", IDC_HK_AUTOPASTE, 7, 38, 266, 10, WS_TABSTOP
    LTEXT "メニューに出す履歴件数(&M)", -1, 7, 55, 124, 8
    EDITTEXT IDC_HK_MENU_ITEMS, 134, 53, 50, 12, ES_NUMBER | WS_TABSTOP
    CONTROL "", IDC_HK_MENU_ITEMS_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0
    AUTOCHECKBOX "ピン留めを履歴より上に表示する(&U)", IDC_HK_PINNED_FIRST, 7, 70, 266, 10, WS_TABSTOP
    AUTOCHECKBOX "メニュー項目にツールチップ（全文・サムネイル）を表示する(&T)", IDC_HK_TOOLTIP, 7, 85, 266, 10, WS_TABSTOP
    LTEXT "表示までの待ち時間（ミリ秒）(&D)", -1, 19, 102, 112, 8
    EDITTEXT IDC_HK_TIP_DELAY, 134, 100, 50, 12, ES_NUMBER | WS_TABSTOP
    CONTROL "", IDC_HK_TIP_DELAY_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0
    LTEXT "最大文字数(&C)", -1, 19, 117, 112, 8
    EDITTEXT IDC_HK_TIP_CHARS, 134, 115, 55, 12, ES_NUMBER | WS_TABSTOP
    CONTROL "", IDC_HK_TIP_CHARS_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0
    LTEXT "最大行数(&L)", -1, 19, 132, 112, 8
    EDITTEXT IDC_HK_TIP_LINES, 134, 130, 50, 12, ES_NUMBER | WS_TABSTOP
    CONTROL "", IDC_HK_TIP_LINES_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0
    LTEXT "修飾キーの二度押し", -1, 7, 151, 266, 8
    LTEXT "Ctrl×2(&1)", -1, 19, 166, 50, 8
    COMBOBOX IDC_HK_DP_CTRL, 72, 164, 140, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Shift×2(&2)", -1, 19, 182, 50, 8
    COMBOBOX IDC_HK_DP_SHIFT, 72, 180, 140, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Alt×2(&3)", -1, 19, 198, 50, 8
    COMBOBOX IDC_HK_DP_ALT, 72, 196, 140, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

IDD_PAGE_TEXT DIALOGEX 0, 0, 280, 232
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    LTEXT "引用符(&Q)", -1, 7, 9, 100, 8
    EDITTEXT IDC_TX_QUOTE, 110, 7, 60, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "折り返し幅（半角換算）(&W)", -1, 7, 25, 100, 8
    EDITTEXT IDC_TX_WRAP, 110, 23, 50, 12, ES_NUMBER | WS_TABSTOP
    CONTROL "", IDC_TX_WRAP_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_NOTHOUSANDS | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 0, 0, 0, 0
    LTEXT "挟み込み: 前(&B)", -1, 7, 41, 100, 8
    EDITTEXT IDC_TX_OPEN, 110, 39, 90, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "挟み込み: 後(&E)", -1, 7, 57, 100, 8
    EDITTEXT IDC_TX_CLOSE, 110, 55, 90, 12, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "改行の除去で2行目以降の行頭空白も除去する(&R)", IDC_TX_TRIM, 7, 72, 266, 10, WS_TABSTOP
    AUTOCHECKBOX "ピン留めの送出時に %d/%t を日時へ変換する(&D)", IDC_TX_DATE, 7, 87, 266, 10, WS_TABSTOP
    LTEXT "日付書式(&F)", -1, 19, 103, 88, 8
    EDITTEXT IDC_TX_DATE_FMT, 110, 101, 90, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "時刻書式(&T)", -1, 19, 119, 88, 8
    EDITTEXT IDC_TX_TIME_FMT, 110, 117, 90, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "書式例: yyyy/MM/dd・HH:mm:ss（空欄はロケール既定）", -1, 19, 133, 254, 8
END

// 形式フィルタ。一覧は表示だけで、選んだ行を下の入力欄で編集する（別のダイアログは開かない）。
IDD_PAGE_FORMAT DIALOGEX 0, 0, 280, 232
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    LTEXT "リストにない形式(&D)", -1, 7, 9, 90, 8
    COMBOBOX IDC_FMT_DEFAULT, 100, 7, 70, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "形式の一覧(&L)", -1, 7, 25, 266, 8
    CONTROL "", IDC_FMT_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 35, 266, 103
    PUSHBUTTON "追加(&A)", IDC_FMT_ADD, 7, 142, 50, 14, WS_TABSTOP
    PUSHBUTTON "削除(&R)", IDC_FMT_DELETE, 60, 142, 50, 14, WS_TABSTOP
    LTEXT "形式名(&N)", -1, 7, 164, 60, 8
    EDITTEXT IDC_FMT_NAME, 70, 162, 150, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "動作(&C)", -1, 7, 180, 60, 8
    COMBOBOX IDC_FMT_ACTION, 70, 178, 70, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "保存する(&S)", IDC_FMT_SAVE, 150, 179, 123, 10, WS_TABSTOP
    LTEXT "上限（バイト）(&U)", -1, 7, 196, 60, 8
    EDITTEXT IDC_FMT_LIMIT, 70, 194, 70, 12, ES_NUMBER | WS_TABSTOP
    LTEXT "", IDC_FMT_LIMIT_SIZE, 145, 196, 128, 8
    LTEXT "（0=無制限。これより大きいデータは取り込まない）", -1, 70, 210, 203, 8
END

// ウィンドウフィルタ。コピー元の窓がこれに当たると取り込まない。
IDD_PAGE_WINDOW DIALOGEX 0, 0, 280, 232
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    LTEXT "コピー元の窓の一覧(&L)", -1, 7, 7, 266, 8
    CONTROL "", IDC_WIN_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 17, 266, 119
    PUSHBUTTON "追加(&A)", IDC_WIN_ADD, 7, 140, 50, 14, WS_TABSTOP
    PUSHBUTTON "削除(&R)", IDC_WIN_DELETE, 60, 140, 50, 14, WS_TABSTOP
    LTEXT "タイトル(&T)", -1, 7, 162, 60, 8
    EDITTEXT IDC_WIN_TITLE, 70, 160, 203, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "クラス名(&N)", -1, 7, 178, 60, 8
    EDITTEXT IDC_WIN_CLASS, 70, 176, 203, 12, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "除外する（取り込まない）(&X)", IDC_WIN_IGNORE, 70, 192, 203, 10, WS_TABSTOP
    LTEXT "（タイトルは部分一致、クラス名は完全一致。両方が空の行は使えません）", -1, 7, 210, 266, 8
END
